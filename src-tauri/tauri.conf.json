{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waystone-Analyzer",
  "mainBinaryName": "Waystone-Analyzer",
  "version": "1.0.0-rc.1",
  "identifier": "com.captain-vii.waystone-analyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://raw.githubusercontent.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://raw.githubusercontent.com ws://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NjQ3MjBDRDdEN0FDMDIKUldRQ3JOZlhESEprWlhLVmxlWjlxTjIyaFJ3OXJ1bXZvR3dTMFJaSVN4TklBSnJRMHVTTTlzTzcK",
      "endpoints": [
        "https://github.com/Captain-VII/poe2-waystone-analyzer/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Captain-VII",
    "shortDescription": "PoE2 Waystone analysis overlay",
    "longDescription": "An in-game overlay that reads a copied Path of Exile 2 Waystone and shows its heat score, tier verdict, and recommended tablets in a dark-fantasy relic-styled Compact/Full panel.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
